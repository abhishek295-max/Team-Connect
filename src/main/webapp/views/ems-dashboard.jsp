id="overview"><section class="hero"><div><div class="eyebrow">TeamConnect workforce hub</div><h2>Good to see you, <%=employee.getName()%>.</h2><p>People operations, team communication and your workday in one secure place.</p></div><a class="btn" href="<%=ctx%>/chat">Open team chat â†’</a></section><section class="metrics"><div class="card metric"><strong id="projectsCount">â€”</strong><span>Active projects</span></div><div class="card metric"><strong id="leaveCount">â€”</strong><span>Leave requests</span></div><div class="card metric"><strong id="attendanceCount">â€”</strong><span>Attendance entries</span></div><div class="card metric"><strong id="documentCount">â€”</strong><span>My documents</span></div></section><section class="section grid"><div class="card" id="profile"><div class="section-head"><div><h3>My profile</h3><p>Your verified workforce identity</p></div><span class="badge"><%=employee.getStatus()%></span></div><div class="list"><div class="row"><span>Name</span><strong><%=employee.getName()%></strong></div><div class="row"><span>Email</span><strong><%=employee.getEmail()%></strong></div><div class="row"><span>Department</span><strong><%=employee.getDepartment()==null?"â€”":employee.getDepartment().getName()%></strong></div><div class="row"><span>Job title</span><strong><%=employee.getJobTitle()==null?"â€”":employee.getJobTitle()%></strong></div></div></div><div class="card" id="announcements"><div class="section-head"><div><h3>Latest announcements</h3><p>Updates from your organization</p></div></div><div class="list" id="announcementList"><div class="muted">Loading updatesâ€¦</div></div></div></section><section class="section grid"><div class="card" id="leave"><div class="section-head"><div><h3>Leave activity</h3><p>Track your requests and approvals</p></div><a class="btn primary" href="#applyLeave">Apply leave</a></div><div class="list" id="leaveList"><div class="muted">Loading recordsâ€¦</div></div></div><div class="card" id="attendance"><div class="section-head"><div><h3>Attendance pulse</h3><p>Your latest attendance records</p></div><span class="badge">Private</span></div><div class="list" id="attendanceList"><div class="muted">Loading recordsâ€¦</div></div></div></section><section class="section grid"><div class="card" id="projects"><div class="section-head"><div><h3>Projects</h3><p>Collaboration spaces you belong to</p></div></div><div class="list" id="projectList"><div class="muted">Loading projectsâ€¦</div></div></div><div class="card" id="payroll"><div class="section-head"><div><h3>Payroll</h3><p>Private payment history</p></div><span class="badge">Protected</span></div><div class="list" id="payrollList"><div class="muted">Loading payrollâ€¦</div></div></div></section><section class="section grid"><div class="card" id="documents"><div class="section-head"><div><h3>Documents</h3><p>Secure employee file vault</p></div><span class="badge">20 MB max</span></div><div class="list" id="documentList"><div class="muted">Loading filesâ€¦</div></div><form class="form" id="documentForm" style="margin-top:14px"><label>Select a file<input type="file" name="file" required></label><button class="btn primary" type="submit">Upload securely</button></form></div><div class="card" id="performance"><div class="section-head"><div><h3>Performance</h3><p>Reviews and growth feedback</p></div><span class="badge">Private</span></div><div class="list" id="performanceList"><div class="muted">Loading reviewsâ€¦</div></div></div></section><section class="section card" id="applyLeave"><div class="section-head"><div><h3>Request time off</h3><p>Submit a leave request for approval</p></div></div><form class="form" id="leaveForm"><label>Leave type<select name="leaveType"><option>Annual</option><option>Sick</option><option>Emergency</option><option>Unpaid</option></select></label><label>Start date<input type="date" name="startDate" required></label><label>End date<input type="date" name="endDate" required></label><label>Reason<textarea name="reason" maxlength="500" required></textarea></label><button class="btn primary" type="submit">Submit request</button></form></section><section class="section card" id="settings"><div class="section-head"><div><h3>Dashboard settings</h3><p>Personalize your TeamConnect workforce experience</p></div><span class="badge">Saved locally</span></div><div class="settings-grid"><div class="setting"><strong>Theme</strong><span>Choose Light, Midnight, Graphite or Aurora above.</span></div><div class="setting"><strong>Motion</strong><span>Animations respect your browser accessibility preference.</span></div><div class="setting"><strong>Chat</strong><span>Use Team Chat in the sidebar for real-time collaboration.</span></div></div></section></div></main></div><div class="toast" id="toast"></div><script>
const ctx='<%=ctx%>',employeeId='<%=employee.getId()%>',toastEl=document.getElementById('toast'),themeSelect=document.getElementById('themeSelect');let saved=localStorage.getItem('tcTheme')||'light';document.documentElement.dataset.theme=saved;themeSelect.value=saved;themeSelect.onchange=()=>{document.body.classList.add('theme-changing');document.documentElement.dataset.theme=themeSelect.value;localStorage.setItem('tcTheme',themeSelect.value);setTimeout(()=>document.body.classList.remove('theme-changing'),700)};document.getElementById('collapse').onclick=()=>document.body.classList.toggle('collapsed');document.getElementById('mobile').onclick=()=>document.body.classList.toggle('mobile-open');document.querySelectorAll('.nav a').forEach(a=>a.onclick=()=>{document.querySelectorAll('.nav a').forEach(x=>x.classList.remove('active'));a.classList.add('active')});const $=x=>document.getElementById(x),esc=x=>String(x??'â€”').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),toast=x=>{toastEl.textContent=x;toastEl.classList.add('show');setTimeout(()=>toastEl.classList.remove('show'),2800)},api=async(p,o)=>{let r=await fetch(ctx+p,o);if(!r.ok)throw Error();return r.json()},rows=(id,a,fn)=>$(id).innerHTML=a.length?a.map(fn).join(''):'<div class="muted">Nothing here yet.</div>';async function load(){try{let[p,l,a,pay,d,rev,n]=await Promise.all([api('/api/ems/projects/me'),api('/api/ems/leave/me'),api('/api/ems/attendance/me'),api('/api/ems/payroll/me'),api('/api/ems/documents/me'),api('/api/ems/performance/me'),api('/api/ems/announcements')]);$('projectsCount').textContent=p.length;$('leaveCount').textContent=l.length;$('attendanceCount').textContent=a.length;$('documentCount').textContent=d.length;rows('leaveList',l.slice(0,5),x=>'<div class="row"><span>'+esc(x.leaveType)+'<small>'+esc(x.startDate)+' â†’ '+esc(x.endDate)+'</small></span><span class="badge">'+esc(x.status)+'</span></div>');rows('attendanceList',a.slice(0,5),x=>'<div class="row"><span>'+esc(x.date)+'<small>'+esc(x.notes||'Attendance record')+'</small></span><span class="badge">'+esc(x.status)+'</span></div>');rows('projectList',p.slice(0,5),x=>'<div class="row"><span>'+esc(x.projectName)+'<small>'+esc(x.description||'Team project')+'</small></span><span class="badge">'+esc(x.status)+'</span></div>');rows('payrollList',pay.slice(0,5),x=>'<div class="row"><span>'+esc(x.periodLabel)+'<small>'+esc(x.paymentDate)+'</small></span><strong>'+esc(x.status)+'</strong></div>');rows('documentList',d.slice(0,5),x=>'<div class="row"><a href="'+ctx+'/api/ems/documents/'+encodeURIComponent(x.id)+'/download">'+esc(x.originalName)+'</a><small>'+esc(x.uploadedAt||'Secure file')+'</small></div>');rows('performanceList',rev.slice(0,5),x=>'<div class="row"><span>'+esc(x.reviewDate)+'<small>'+esc(x.status)+'</small></span><strong>'+esc(x.rating||'â€”')+'/5</strong></div>');rows('announcementList',n.slice(0,5),x=>'<div class="row"><span><strong>'+esc(x.title)+'</strong><small>'+esc(x.body)+'</small></span></div>')}catch(e){toast('Some dashboard data could not be loaded')}}$('leaveForm').onsubmit=async e=>{e.preventDefault();try{await api('/api/ems/leave',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});e.target.reset();toast('Leave request submitted');load()}catch(x){toast('Leave request failed')}};$('documentForm').onsubmit=async e=>{e.preventDefault();let f=new FormData(e.target);f.append('employeeId',employeeId);try{await api('/api/ems/documents',{method:'POST',body:f});e.target.reset();toast('Document uploaded successfully');load()}catch(x){toast('Upload failed. Check file size and login session')}};load();
</script><style>.btn,.icon,.nav a,.badge,.row,.metric,.card,.form input,.form select,.form textarea{will-change:transform}.btn:focus-visible,.icon:focus-visible,.nav a:focus-visible,.form input:focus-visible,.form select:focus-visible,.form textarea:focus-visible{outline:3px solid color-mix(in srgb,var(--accent) 35%,transparent);outline-offset:3px}.btn:not(.primary):hover{background:var(--soft)}.form input:hover,.form select:hover,.form textarea:hover{border-color:var(--accent);transform:translateY(-1px)}.form input:focus,.form select:focus,.form textarea:focus{border-color:var(--accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 16%,transparent),0 8px 20px #1e4b7214;transform:translateY(-2px)}.form select{cursor:pointer}.nav a{position:relative;overflow:hidden}.nav a:after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,transparent,#ffffff20,transparent);transform:translateX(-120%);transition:transform .55s}.nav a:hover:after{transform:translateX(120%)}.card{animation:rise .65s cubic-bezier(.2,.8,.2,1) both}.section{animation:sectionIn .7s cubic-bezier(.2,.8,.2,1) both}.row{transition:transform .22s,border-color .22s,box-shadow .22s}.row:hover{box-shadow:0 8px 20px color-mix(in srgb,var(--accent) 12%,transparent)}html{scrollbar-width:thin;scrollbar-color:var(--accent) transparent}::-webkit-scrollbar{width:10px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:linear-gradient(var(--accent),var(--cyan));border-radius:99px;border:3px solid var(--bg)}@keyframes sectionIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){.btn,.icon,.nav a,.row,.card,.form input,.form select,.form textarea{transition:none!important;transform:none!important;animation:none!important}}</style><style>.side{display:flex;flex-direction:column}.side .nav{flex:1;align-content:start}.side-note{position:static;margin:18px 10px 0;padding-top:16px;border-top:1px solid #ffffff14}.collapsed .side-note{display:none}</style></body></html>




