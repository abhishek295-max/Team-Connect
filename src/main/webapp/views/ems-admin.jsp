<%@ page contentType="text/html;charset=UTF-8" %><% String ctx=request.getContextPath(); %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>EMS Command Center Â· TeamConnect</title><style>
:root{--bg:#f4f7fb;--surface:#fff;--surface2:#f8fbff;--ink:#10243d;--muted:#71839a;--line:#dbe6f1;--nav:#091a30;--nav2:#102b4c;--blue:#4c9bff;--mint:#6de0bd;--shadow:0 18px 50px #1b477018;--danger:#e25d70;color-scheme:light}html[data-theme=dark]{--bg:#050b18;--surface:#0c1930;--surface2:#101f3a;--ink:#eef5ff;--muted:#a2b5d1;--line:#263d61;--nav:#030b19;--nav2:#112b4b;--shadow:0 22px 55px #0009;color-scheme:dark}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 85% -5%,#84c4ff33,transparent 28rem),var(--bg);color:var(--ink);font:14px Inter,system-ui,sans-serif;transition:background .35s,color .35s}.app{display:flex;min-height:100vh}.side{width:270px;flex:0 0 270px;position:fixed;inset:0 auto 0 0;z-index:10;padding:22px 15px;background:linear-gradient(180deg,var(--nav),#071225);color:#d9e8f8;box-shadow:14px 0 45px #06122530;transition:.35s}.brand{display:flex;align-items:center;gap:11px;padding:8px 11px 28px;font-weight:800}.mark{display:grid;place-items:center;width:40px;height:40px;border-radius:13px;background:linear-gradient(135deg,var(--blue),var(--mint));color:#06203b;font-weight:900;box-shadow:0 9px 25px #5ea7ff55}.brand small{display:block;color:#8ca6c2;font-size:10px;font-weight:500;margin-top:3px}.nav{display:grid;gap:5px}.nav a{display:flex;align-items:center;gap:12px;padding:12px 13px;border-radius:12px;color:#a7bdd5;text-decoration:none;transition:.22s}.nav a:hover,.nav a.active{color:#fff;background:linear-gradient(90deg,var(--nav2),#173a5e);transform:translateX(3px)}.nav i{width:19px;font-style:normal;text-align:center}.nav b{font-weight:650}.foot{position:absolute;bottom:22px;left:25px;color:#7894b3;font-size:11px;line-height:1.6}.main{margin-left:270px;flex:1;min-width:0}.top{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:15px clamp(18px,4vw,55px);border-bottom:1px solid var(--line);background:#ffffffc9;backdrop-filter:blur(18px)}html[data-theme=dark] .top{background:#071328dd}.top-left{display:flex;align-items:center;gap:13px}.top h1{margin:0;font-size:19px}.top small{display:block;color:var(--muted);margin-top:3px}.actions{display:flex;gap:9px;align-items:center}.btn{border:1px solid var(--line);border-radius:11px;padding:10px 13px;background:var(--surface);color:var(--ink);font:600 12px inherit;text-decoration:none;cursor:pointer;transition:.2s}.btn:hover{transform:translateY(-2px);border-color:var(--blue);box-shadow:0 9px 22px #4c9bff2b}.btn.primary{border:0;color:#06203b;background:linear-gradient(110deg,var(--blue),var(--mint));box-shadow:0 9px 22px #4c9bff3d}.icon-btn{font-size:18px;padding:8px 11px}.content{max-width:1500px;margin:auto;padding:34px clamp(18px,4vw,58px) 70px}.hero{display:flex;justify-content:space-between;align-items:flex-end;gap:22px;padding:31px 34px;border-radius:24px;color:#fff;background:linear-gradient(120deg,#092957,#1262bd 55%,#38b7e8);box-shadow:0 25px 60px #1262bd33;overflow:hidden;position:relative}.hero:after{content:"";position:absolute;width:260px;height:260px;border:1px solid #ffffff55;border-radius:50%;right:8%;top:-130px;box-shadow:0 0 0 30px #ffffff0d,0 0 0 60px #ffffff08;animation:orbit 12s linear infinite}.hero h2{font-size:clamp(28px,4vw,45px);letter-spacing:-.05em;margin:0 0 8px}.hero p{margin:0;color:#d8edff}.hero .btn{position:relative;z-index:1;background:#ffffffee;color:#134d86;border:0}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin-top:18px}.card{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:21px;box-shadow:var(--shadow);transition:background .35s,border-color .35s,transform .25s;animation:rise .65s both}.card:hover{transform:translateY(-4px)}.kpi{position:relative;overflow:hidden}.kpi:after{content:"";position:absolute;width:90px;height:90px;border-radius:50%;right:-34px;top:-34px;background:linear-gradient(135deg,var(--blue),var(--mint));opacity:.15}.kpi .num{font-size:34px;font-weight:850;letter-spacing:-.06em}.kpi span{display:block;color:var(--muted);margin-top:5px}.grid{display:grid;grid-template-columns:1.1fr .9fr;gap:18px;margin-top:18px}.card-head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:15px}.card h3{margin:0;font-size:18px}.card-head p{margin:4px 0 0;color:var(--muted);font-size:12px}.search{max-width:220px;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:var(--surface2);color:var(--ink);outline:0}.list{display:grid;gap:9px}.row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px;border:1px solid var(--line);border-radius:12px;background:var(--surface2);transition:.2s}.row:hover{border-color:var(--blue);transform:translateX(3px)}.row small{display:block;color:var(--muted);margin-top:3px}.badge{padding:5px 8px;border-radius:99px;background:#4c9bff1c;color:var(--blue);font-size:10px;font-weight:800}.form{display:grid;gap:11px}.form label{color:var(--muted);font-size:12px;font-weight:700}.form input,.form textarea,.form select{display:block;width:100%;margin-top:6px;padding:11px 12px;border:1px solid var(--line);border-radius:10px;background:var(--surface2);color:var(--ink);font:inherit;outline:0}.form textarea{min-height:95px;resize:vertical}.table-wrap{overflow:auto}.tabs{display:flex;gap:8px;margin:24px 0 0}.tab{border:0;background:transparent;color:var(--muted);padding:10px 13px;border-bottom:2px solid transparent;cursor:pointer;font-weight:700}.tab.active{color:var(--blue);border-color:var(--blue)}.hidden{display:none!important}.toast{position:fixed;right:24px;bottom:24px;padding:13px 16px;border-radius:12px;background:#102b4c;color:#fff;box-shadow:var(--shadow);opacity:0;transform:translateY(12px);transition:.25s;z-index:30}.toast.show{opacity:1;transform:none}@keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}@keyframes orbit{to{transform:rotate(360deg)}}@media(max-width:1000px){.kpis{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}}@media(max-width:700px){.side{width:76px;flex-basis:76px}.brand div,.nav b,.foot{display:none}.brand{justify-content:center}.nav a{justify-content:center}.main{margin-left:76px}.hero{display:block;padding:25px}.hero .btn{display:inline-block;margin-top:18px}.top{padding:13px 17px}.top h1{font-size:15px}.actions .back{display:none}}@media(max-width:480px){.kpis{grid-template-columns:1fr 1fr}.grid{display:block}.grid>.card{margin-top:15px}.card-head{align-items:flex-start;flex-direction:column}.search{max-width:none;width:100%}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
</style></head><body><div class="app"><aside class="side"><div class="brand"><span class="mark">TC</span><div>TeamConnect<small>EMS command center</small></div></div><nav class="nav"><a class="active" href="#overview">âŒ‚ <b>Overview</b></a><a href="#directory">â™™ <b>Employee directory</b></a><a href="#leave">âœ“ <b>Leave approvals</b></a><a href="#announcements">â—‡ <b>Announcements</b></a><a href="#operations">â–£ <b>Operations</b></a><a href="<%=ctx%>/admin">â† <b>TeamConnect admin</b></a></nav><div class="foot">ADMINISTRATOR ACCESS<br>All actions are audited</div></aside><main class="main"><header class="top"><div class="top-left"><button id="theme" class="btn icon-btn" title="Toggle light and dark theme">â—</button><div><h1>EMS command center</h1><small>Secure workforce administration</small></div></div><div class="actions"><a class="btn back" href="<%=ctx%>/admin">Back to admin</a><a class="btn primary" href="<%=ctx%>/chat">Open team chat</a></div></header><div class="content" id="overview"><section class="hero"><div><p style="text-transform:uppercase;letter-spacing:.16em;font-size:11px;font-weight:800">People operations cockpit</p><h2>Run your workforce with clarity.</h2><p>Employee records, approvals, announcements and operational health in one controlled workspace.</p></div><a class="btn" href="#announcements">Publish update â†’</a></section><section class="kpis"><div class="card kpi"><div class="num" id="employees">â€”</div><span>Total employees</span></div><div class="card kpi"><div class="num" id="activeEmployees">â€”</div><span>Active workforce</span></div><div class="card kpi"><div class="num" id="projects">â€”</div><span>Projects</span></div><div class="card kpi"><div class="num" id="leaveRequests">â€”</div><span>Leave requests</span></div></section><div class="tabs"><button class="tab active" data-tab="all">All operations</button><button class="tab" data-tab="people">People</button><button class="tab" data-tab="governance">Governance</button></div><section class="grid"><div class="card" id="directory" data-group="people all"><div class="card-head"><div><h3>Employee directory</h3><p>Search role, email and workforce status.</p></div><input class="search" id="employeeSearch" placeholder="Search employees"></div><div class="list" id="employeeList"><p class="muted">Loading directoryâ€¦</p></div></div><div class="card" id="leave" data-group="governance all"><div class="card-head"><div><h3>Leave approvals</h3><p>Review and notify employees securely.</p></div><span class="badge">HR workflow</span></div><div class="list" id="leaveList"><p class="muted">Loading approvalsâ€¦</p></div></div></section><section class="grid"><div class="card" id="announcements" data-group="governance all"><div class="card-head"><div><h3>Organization announcements</h3><p>Publish an auditable update to the workforce.</p></div></div><form class="form" id="announcementForm"><label>Title<input name="title" maxlength="180" required placeholder="Announcement title"></label><label>Message<textarea name="body" maxlength="3000" required placeholder="Write the announcementâ€¦"></textarea></label><label>Audience<select name="audience"><option value="ALL">All employees</option><option value="HR">HR</option><option value="MANAGERS">Managers</option></select></label><button class="btn primary">Publish and notify</button></form></div><div class="card" id="operations" data-group="all people"><div class="card-head"><div><h3>Operational health</h3><p>Live counts from EMS modules.</p></div></div><div class="list" id="summary"><p class="muted">Loading summaryâ€¦</p></div></div></section></div></main></div><div class="toast" id="toast"></div><script>
const ctx='<%=ctx%>',theme=document.getElementById('theme'),toastEl=document.getElementById('toast');document.documentElement.dataset.theme=localStorage.getItem('tcAdminTheme')||'light';theme.onclick=()=>{let t=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=t;localStorage.setItem('tcAdminTheme',t)};const esc=x=>String(x??'â€”').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const toast=x=>{toastEl.textContent=x;toastEl.classList.add('show');setTimeout(()=>toastEl.classList.remove('show'),2600)};async function api(p,o){let r=await fetch(ctx+p,o);if(!r.ok)throw Error();return r.json()}let people=[],leave=[];function drawPeople(){let q=document.getElementById('employeeSearch').value.toLowerCase();let a=people.filter(x=>(x.name+' '+x.email+' '+x.role).toLowerCase().includes(q));document.getElementById('employeeList').innerHTML=a.map(x=>'<div class="row"><span><strong>'+esc(x.name)+'</strong><small>'+esc(x.email)+'</small></span><span class="badge">'+esc(x.role)+'</span></div>').join('')||'<p class="muted">No matching employees.</p>'}async function load(){try{let[s,e,l]=await Promise.all([api('/api/ems/reports/summary'),api('/api/ems/employees'),api('/api/ems/leave')]);people=e;leave=l;Object.entries(s).forEach(([k,v])=>{let el=document.getElementById(k);if(el)el.textContent=v});drawPeople();document.getElementById('leaveList').innerHTML=leave.slice(0,10).map(x=>'<div class="row"><span><strong>Employee #'+esc(x.employeeId)+'</strong><small>'+esc(x.startDate)+' â†’ '+esc(x.endDate)+' Â· '+esc(x.reason||'No reason')+'</small></span><span><span class="badge">'+esc(x.status)+'</span><br><button class="btn" style="margin-top:7px;padding:6px 8px" onclick="review('+x.id+',\'APPROVED\')">Approve</button> <button class="btn" style="margin-top:7px;padding:6px 8px" onclick="review('+x.id+',\'REJECTED\')">Reject</button></span></div>').join('')||'<p class="muted">No pending requests.</p>';document.getElementById('summary').innerHTML=Object.entries(s).map(([k,v])=>'<div class="row"><span>'+esc(k)+'</span><strong>'+esc(v)+'</strong></div>').join('')}catch(e){toast('Admin data is currently unavailable')}}async function review(id,status){try{await api('/api/ems/leave/'+id+'/status?status='+status,{method:'PATCH'});toast('Leave request '+status.toLowerCase());load()}catch(e){toast('Unable to update leave request')}}document.getElementById('employeeSearch').oninput=drawPeople;document.getElementById('announcementForm').onsubmit=async e=>{e.preventDefault();try{await api('/api/ems/announcements',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});e.target.reset();toast('Announcement published and notifications sent');load()}catch(x){toast('Announcement could not be published')}};document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));t.classList.add('active');let v=t.dataset.tab;document.querySelectorAll('[data-group]').forEach(x=>x.classList.toggle('hidden',v!=='all'&&!x.dataset.group.includes(v)))});load();
</script><style>.btn,.tab,.nav a,.card,.row,.search,.form input,.form select,.form textarea{will-change:transform}.btn:focus-visible,.tab:focus-visible,.nav a:focus-visible,.search:focus-visible,.form input:focus-visible,.form select:focus-visible,.form textarea:focus-visible{outline:3px solid color-mix(in srgb,var(--blue) 35%,transparent);outline-offset:3px}.form input:hover,.form select:hover,.form textarea:hover,.search:hover{border-color:var(--blue);transform:translateY(-1px)}.form input:focus,.form select:focus,.form textarea:focus,.search:focus{border-color:var(--blue);box-shadow:0 0 0 4px color-mix(in srgb,var(--blue) 17%,transparent),0 8px 20px #1e4b7214;transform:translateY(-2px)}.tab{transition:color .2s,border-color .2s,transform .2s}.tab:hover{transform:translateY(-2px)}.nav a{position:relative;overflow:hidden}.nav a:after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,transparent,#ffffff20,transparent);transform:translateX(-120%);transition:transform .55s}.nav a:hover:after{transform:translateX(120%)}.card{animation:rise .65s cubic-bezier(.2,.8,.2,1) both}.row{transition:transform .22s,border-color .22s,box-shadow .22s}.row:hover{box-shadow:0 8px 20px color-mix(in srgb,var(--blue) 14%,transparent)}html{scrollbar-width:thin;scrollbar-color:var(--blue) transparent}::-webkit-scrollbar{width:10px}::-webkit-scrollbar-thumb{background:linear-gradient(var(--blue),var(--mint));border-radius:99px;border:3px solid var(--bg)}@media(prefers-reduced-motion:reduce){.btn,.tab,.nav a,.row,.card,.search,.form input,.form select,.form textarea{transition:none!important;transform:none!important;animation:none!important}}</style><style id="tc-premium-ui">
:root{--tc-ease:cubic-bezier(.2,.8,.2,1)}
body{transition:background .6s ease,color .45s ease}
body:not(.dashboard):before{transition:opacity .6s,transform .6s}
button,a,input,select,textarea{transition:transform .28s var(--tc-ease),box-shadow .28s,border-color .28s,background .45s,color .3s}
button:hover,a:hover{transform:translateY(-2px)}
button:active,a:active{transform:scale(.97)}
input:hover,select:hover,textarea:hover{border-color:color-mix(in srgb,var(--accent,#4c9bff) 55%,#fff0)}
input:focus,select:focus,textarea:focus{outline:0;transform:translateY(-2px);box-shadow:0 0 0 4px color-mix(in srgb,var(--accent,#4c9bff) 18%,transparent),0 12px 28px #1d64aa16}
.card,.panel,.auth-page,.auth-wrapper,.shell,.form-section,.image-section,.sidebar,.conversation,.insights,.workspace-card{transition:transform .4s var(--tc-ease),box-shadow .4s,border-color .4s,background .5s}
.card:hover,.panel:hover,.workspace-card:hover{transform:translateY(-6px);box-shadow:0 24px 60px color-mix(in srgb,var(--accent,#4c9bff) 15%,transparent)}
.reveal,.section,.auth-page,.tile,.role{animation:tcEnter .72s var(--tc-ease) both}
@keyframes tcEnter{from{opacity:0;transform:translateY(18px) scale(.985)}to{opacity:1;transform:none}}
@keyframes tcShimmer{from{transform:translateX(-130%)}to{transform:translateX(130%)}}
@keyframes tcPulse{50%{box-shadow:0 0 0 8px color-mix(in srgb,var(--accent,#4c9bff) 10%,transparent)}}
::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:linear-gradient(var(--accent,#4c9bff),var(--cyan,#6de0bd));border:3px solid transparent;background-clip:padding-box;border-radius:99px}
body.theme-changing:after{content:"";position:fixed;inset:0;z-index:999;background:radial-gradient(circle at 50% 0,color-mix(in srgb,var(--accent,#4c9bff) 28%,transparent),transparent 55%);pointer-events:none;animation:tcTheme .7s ease both}
@keyframes tcTheme{from{opacity:0;transform:scale(.8)}45%{opacity:1}to{opacity:0;transform:scale(1.15)}}
@media(max-width:700px){button:hover,a:hover{transform:none}.card:hover,.panel:hover,.workspace-card:hover{transform:translateY(-3px)}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;transform:none!important}}
</style><script id="tc-premium-behavior">
(function(){function animateTheme(){document.body.classList.remove("theme-changing");void document.body.offsetWidth;document.body.classList.add("theme-changing");setTimeout(function(){document.body.classList.remove("theme-changing")},700)}["theme","themeToggle","themeSelect"].forEach(function(id){var e=document.getElementById(id);if(e)e.addEventListener("click",animateTheme)});var r=document.querySelectorAll(".card,.panel,.tile,.role,.section,.auth-page");r.forEach(function(e,i){e.style.animationDelay=Math.min(i*.045,.5)+"s"});})();
</script></body></html>

