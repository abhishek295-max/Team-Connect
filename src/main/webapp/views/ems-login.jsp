<%@ page contentType="text/html;charset=UTF-8" %>
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sign in · TeamConnect Workforce</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{--bg:#eef3fb;--surface:rgba(255,255,255,.86);--surface2:#f7faff;--ink:#12243c;--muted:#71839b;--line:#dce6f1;--accent:#347fe8;--accent2:#6de0bd;--shadow:0 28px 90px rgba(40,73,121,.16);color-scheme:light}html[data-theme=dark]{--bg:#070d1a;--surface:rgba(14,27,49,.88);--surface2:#0b1930;--ink:#eef5ff;--muted:#a5b7d1;--line:#263c5d;--accent:#70a1ff;--accent2:#64e0c5;--shadow:0 28px 90px #0009;color-scheme:dark}*{box-sizing:border-box}html{min-height:100%;transition:background .4s}body{margin:0;min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 8% 12%,#7aaeff44,transparent 30rem),radial-gradient(circle at 92% 85%,#54d6bd3b,transparent 27rem),var(--bg);color:var(--ink);font:14px 'DM Sans',sans-serif;overflow-x:hidden;transition:background .4s,color .4s}body:before,body:after{content:"";position:fixed;border-radius:50%;pointer-events:none;z-index:-1}.body:before{display:none}body:before{width:180px;height:180px;left:9%;bottom:6%;border:1px solid #77a2ff44;box-shadow:0 0 0 25px #77a2ff0d,0 0 0 50px #77a2ff07;animation:orbit 13s linear infinite}body:after{width:230px;height:230px;right:10%;top:7%;background:linear-gradient(140deg,#74a1ff1f,transparent);filter:blur(2px);animation:drift 7s ease-in-out infinite}.shell{width:min(1120px,calc(100% - 42px));min-height:680px;display:grid;grid-template-columns:1.04fr .96fr;border:1px solid rgba(255,255,255,.65);border-radius:30px;overflow:hidden;background:var(--surface);box-shadow:var(--shadow);backdrop-filter:blur(24px);animation:shellIn .85s cubic-bezier(.2,.8,.2,1) both}.visual{position:relative;overflow:hidden;padding:42px;display:flex;flex-direction:column;justify-content:space-between;color:#fff;background:linear-gradient(145deg,#092c5bde,#1269bce8 55%,#2bbda9d9),url('https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1200&q=85') center/cover}.visual:before{content:"";position:absolute;width:440px;height:440px;border:1px solid #ffffff46;border-radius:50%;right:-180px;top:-170px;box-shadow:0 0 0 30px #ffffff0b,0 0 0 65px #ffffff08;animation:orbit 18s linear infinite}.visual:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,#06152c22,#06152ccc)}.visual>*{position:relative;z-index:1}.brand{display:flex;align-items:center;gap:12px;font:800 17px Manrope}.mark{width:44px;height:44px;display:grid;place-items:center;border-radius:14px;background:linear-gradient(135deg,#8aa7ff,#5f52df);box-shadow:0 12px 28px #06162d66}.brand small{display:block;margin-top:3px;color:#c5dcf8;font:500 10px 'DM Sans'}.visual-copy{max-width:390px}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:#c6f6eb;text-transform:uppercase;letter-spacing:.14em;font-size:10px;font-weight:800}.eyebrow i{font-size:7px;color:#6de0bd}.visual h2{font:800 clamp(36px,4.5vw,61px)/1.03 Manrope;letter-spacing:-.065em;margin:14px 0}.visual h2 em{font-style:normal;color:#8ef3d9}.visual-copy p{max-width:380px;color:#d2e5fa;font-size:15px;line-height:1.7;margin:0}.trust{display:flex;align-items:center;gap:12px;margin-top:24px;color:#c4d7ef;font-size:11px}.trust .avatars{display:flex}.trust b{width:25px;height:25px;margin-right:-6px;border:2px solid #16477d;border-radius:50%;display:grid;place-items:center;font-size:8px;background:#e19a72}.trust b:nth-child(2){background:#6bcbb6}.trust b:nth-child(3){background:#9a8df1}.visual-bottom{display:flex;gap:11px;flex-wrap:wrap}.float-stat{display:flex;align-items:center;gap:10px;padding:12px 14px;border:1px solid #ffffff2d;border-radius:13px;background:#071d3a72;backdrop-filter:blur(10px);animation:float 4s ease-in-out infinite}.float-stat:nth-child(2){animation-delay:1s}.float-stat i{width:27px;height:27px;display:grid;place-items:center;border-radius:9px;background:#ffffff18;color:#8ef3d9;font-size:11px}.float-stat strong{display:block;font-size:11px}.float-stat span{display:block;margin-top:2px;color:#a9c4e2;font-size:9px}.login{padding:42px 52px;display:flex;flex-direction:column;justify-content:center;position:relative}.theme-toggle{position:absolute;right:28px;top:25px;width:38px;height:38px;border:1px solid var(--line);border-radius:11px;background:var(--surface2);color:var(--ink);cursor:pointer;transition:.3s}.theme-toggle:hover{transform:rotate(14deg) scale(1.06);border-color:var(--accent);box-shadow:0 9px 22px #347fe82b}.login-head{max-width:410px;margin:0 auto;width:100%}.login .mini-mark{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#08213a;font:800 18px Manrope;box-shadow:0 11px 25px #347fe83b}.login h1{font:800 34px Manrope;letter-spacing:-.055em;margin:25px 0 8px}.login .intro{color:var(--muted);line-height:1.65;margin:0 0 25px}.role-label{display:flex;justify-content:space-between;align-items:center;color:var(--ink);font-size:12px;font-weight:700;margin-bottom:7px}.secure{color:var(--accent);font-size:10px;font-weight:600}.role-select{position:relative;margin-bottom:18px}.role-select i{position:absolute;left:13px;top:14px;color:var(--accent);font-size:13px}.role-select select{padding-left:36px!important}.field{margin-top:17px}.field label{display:block;color:var(--ink);font-size:12px;font-weight:700;margin-bottom:7px}.input-wrap{position:relative}.input-wrap i{position:absolute;left:13px;top:14px;color:var(--muted);font-size:13px}.input-wrap button{position:absolute;right:8px;top:7px;width:31px;height:31px;border:0;border-radius:8px;background:transparent;color:var(--muted);cursor:pointer}.input-wrap button:hover{background:var(--line);color:var(--accent)}input,select{width:100%;height:50px;padding:0 42px;border:1px solid var(--line);border-radius:12px;background:var(--surface2);color:var(--ink);font:inherit;outline:0;transition:.28s}select{padding-left:13px;cursor:pointer}input::placeholder{color:#8d9bb0}input:hover,select:hover{border-color:#91aee0;transform:translateY(-1px)}input:focus,select:focus{border-color:var(--accent);box-shadow:0 0 0 4px #347fe826,0 10px 22px #347fe814;transform:translateY(-2px)}.remember{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:12px;margin-top:17px}.remember input{width:16px;height:16px;padding:0;accent-color:var(--accent)}.submit{width:100%;height:51px;margin-top:23px;border:0;border-radius:12px;background:linear-gradient(110deg,var(--accent),var(--accent2));color:#06213b;font-weight:800;cursor:pointer;box-shadow:0 13px 28px #347fe83b;transition:.3s}.submit:hover{transform:translateY(-3px);box-shadow:0 19px 34px #347fe855}.submit:active{transform:scale(.98)}.error{padding:11px 13px;border:1px solid #e1778b55;border-radius:11px;background:#e1778b18;color:#c74e63;font-size:12px;animation:shake .35s ease}.helper{color:var(--muted);font-size:12px;line-height:1.6;margin:21px 0 0}.helper a{color:var(--accent);font-weight:700}.footer-note{margin-top:30px;padding-top:17px;border-top:1px solid var(--line);color:var(--muted);font-size:10px;display:flex;align-items:center;gap:7px}.footer-note i{color:#49cfa9}@keyframes shellIn{from{opacity:0;transform:translateY(22px) scale(.985)}to{opacity:1;transform:none}}@keyframes float{50%{transform:translateY(-8px)}}@keyframes orbit{to{transform:rotate(360deg)}}@keyframes drift{50%{transform:translate(-16px,13px) scale(1.07)}}@keyframes shake{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}@media(max-width:780px){body{padding:20px 0}.shell{display:block;min-height:0;width:min(560px,calc(100% - 28px))}.visual{min-height:370px;padding:30px}.visual h2{font-size:43px}.login{padding:36px 28px 30px}.float-stat{padding:10px}.footer-note{margin-top:24px}}@media(max-width:440px){.visual{min-height:330px;padding:24px}.visual h2{font-size:36px}.visual-copy p{font-size:13px}.visual-bottom{display:none}.login{padding:31px 21px 25px}.login h1{font-size:29px}.theme-toggle{right:19px;top:19px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<main class="shell">
<section class="visual"><a class="brand" href="<%= request.getContextPath() %>/"><span class="mark">TC</span><span>TeamConnect<small>Connected work, beautifully.</small></span></a><div class="visual-copy"><div class="eyebrow"><i class="fa-solid fa-circle"></i> Workforce workspace</div><h2>Good work starts with a <em>connected</em> team.</h2><p>One secure place for conversations, people operations and the moments that keep your organization moving.</p><div class="trust"><div class="avatars"><b>AS</b><b>RK</b><b>MN</b></div><span>Trusted workspace for modern teams</span></div></div><div class="visual-bottom"><div class="float-stat"><i class="fa-solid fa-shield-halved"></i><div><strong>Protected by design</strong><span>Role-aware access</span></div></div><div class="float-stat"><i class="fa-solid fa-bolt"></i><div><strong>Always in sync</strong><span>Live collaboration</span></div></div></div></section>
<section class="login"><button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle dark mode"><i class="fa-solid fa-moon"></i></button><div class="login-head"><div class="mini-mark">TC</div><h1>Welcome back.</h1><p class="intro">Sign in to continue to your workspace and stay close to the work that matters.</p><% if(request.getAttribute("error")!=null){ %><div class="error"><i class="fa-solid fa-circle-exclamation"></i> <%= request.getAttribute("error") %></div><% } %><form method="post" action="<%= request.getContextPath() %>/ems/login"><div class="role-label"><span>Sign in to</span><span class="secure"><i class="fa-solid fa-lock"></i> Secure login</span></div><div class="role-select"><i class="fa-solid fa-briefcase"></i><select name="workspace" aria-label="Choose workspace"><option value="employee">Employee workspace</option><option value="hr">HR workspace</option><option value="manager">Manager workspace</option></select></div><div class="field"><label for="username">Username</label><div class="input-wrap"><i class="fa-regular fa-user"></i><input id="username" name="username" autocomplete="username" placeholder="Enter your username" required></div></div><div class="field"><label for="password">Password</label><div class="input-wrap"><i class="fa-solid fa-key"></i><input id="password" type="password" name="password" autocomplete="current-password" placeholder="Enter your password" required><button id="togglePassword" type="button" aria-label="Show password"><i class="fa-regular fa-eye"></i></button></div></div><label class="remember"><input type="checkbox" name="remember"> Remember this device</label><button class="submit" type="submit">Continue to workspace <i class="fa-solid fa-arrow-right"></i></button></form><p class="helper">Administrators use the separate secure <a href="<%= request.getContextPath() %>/admin">Admin Console <i class="fa-solid fa-arrow-up-right-from-square"></i></a>.</p><div class="footer-note"><i class="fa-solid fa-circle-check"></i> Your role controls the tools and records you can access.</div></div></section>
</main>
<script>const root=document.documentElement,toggle=document.getElementById('themeToggle'),saved=localStorage.getItem('tcLoginTheme')||'light';root.dataset.theme=saved;function syncTheme(){const dark=root.dataset.theme==='dark';toggle.innerHTML=dark?'<i class="fa-solid fa-sun"></i>':'<i class="fa-solid fa-moon"></i>';toggle.setAttribute('aria-label',dark?'Switch to light mode':'Switch to dark mode')}syncTheme();toggle.onclick=function(){root.dataset.theme=root.dataset.theme==='dark'?'light':'dark';localStorage.setItem('tcLoginTheme',root.dataset.theme);syncTheme()};document.getElementById('togglePassword').onclick=function(){const p=document.getElementById('password'),eye=this.querySelector('i');p.type=p.type==='password'?'text':'password';eye.className=p.type==='password'?'fa-regular fa-eye':'fa-regular fa-eye-slash'};</script>
</body></html>
