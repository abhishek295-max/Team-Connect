<script>window.addEventListener('load',function(){setTimeout(function(){document.getElementById('loader').classList.add('hide');document.getElementById('page').classList.add('show')},850)});const observer=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting)e.target.classList.add('show')})},{threshold:.12});document.querySelectorAll('.reveal').forEach(function(e){observer.observe(e)});(function(){const area=document.getElementById('appPreview');if(!area||matchMedia('(prefers-reduced-motion: reduce)').matches)return;area.parentElement.addEventListener('mousemove',function(e){if(innerWidth<900)return;const r=area.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;area.style.transform='perspective(1100px) rotateY('+x*4+'deg) rotateX('+(-y*3)+'deg) translateY(-5px)'});area.parentElement.addEventListener('mouseleave',function(){area.style.transform=''})})();</script>
